#!/bin/sh
# dk <GET|POST> <procedure> [json]  — call the local Dokploy API
. /etc/dokploy-api.env
m=$1; p=$2; shift 2
if [ "$m" = GET ]; then
  curl -sS "$DOKPLOY_URL/api/$p" -H "x-api-key: $DOKPLOY_API_KEY" -H "accept: application/json"
else
  curl -sS -X POST "$DOKPLOY_URL/api/$p" -H "x-api-key: $DOKPLOY_API_KEY" -H "Content-Type: application/json" -d "${1:-{\}}"
fi
